    // 取当前语言下的文本；没有英文条目时回退中文原文
    function t(strText) {
        if (language !== 'en' || !strText) {
            return strText;
        }
        const strHit = enMap[strText];
        return (strHit === undefined) ? strText : strHit;
    }

    // 带参数的翻译：%1..%9 按顺序替换
    function tf(strText, lstArguments) {
        var strResult = t(strText);
        if (!lstArguments) {
            return strResult;
        }
        for (var nIndex = 0; nIndex < lstArguments.length; nIndex++) {
            strResult = strResult.replace('%' + (nIndex + 1), String(lstArguments[nIndex]));
        }
        return strResult;
    }
